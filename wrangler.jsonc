{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cover-lab-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-09-25",
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cover-lab-ai-db",
      "database_id": "4a1c0fa1-f1d0-46c8-964e-f5f2763b2c9a"
    }
  ],
  "triggers": {
    "crons": [
      "*/30 * * * *"
    ]
  },
  "vars": {
    "VERSIONE_MOTORE": "0.6.1",
    "MODELLO_CLASSIFICAZIONE": "@cf/zai-org/glm-4.7-flash",
    "LINGUA_INTERFACCIA": "it",
    "MASSIMO_OPERE_DERIVATE_PER_GIRO": "2",
    "MASSIMO_CANDIDATI_IA_PER_GIRO": "12",
    "ARCHIVIO_VIVO_VOCI_PER_GIRO": "1",
    "ARCHIVIO_VIVO_RICONTROLLO_ORE": "168",
    "ARCHIVIO_VIVO_RITENTA_ORE": "6"
  },
  "previews": {
    "ai": {
      "binding": "AI"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "cover-lab-ai-db",
        "database_id": "4a1c0fa1-f1d0-46c8-964e-f5f2763b2c9a"
      }
    ],
    "vars": {
      "VERSIONE_MOTORE": "0.6.1",
      "MODELLO_CLASSIFICAZIONE": "@cf/zai-org/glm-4.7-flash",
      "LINGUA_INTERFACCIA": "it",
      "MASSIMO_OPERE_DERIVATE_PER_GIRO": "2",
      "MASSIMO_CANDIDATI_IA_PER_GIRO": "12",
      "ARCHIVIO_VIVO_VOCI_PER_GIRO": "1",
      "ARCHIVIO_VIVO_RICONTROLLO_ORE": "168",
      "ARCHIVIO_VIVO_RITENTA_ORE": "6"
    }
  }
}
